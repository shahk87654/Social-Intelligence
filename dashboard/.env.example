DATABASE_URL=postgres://localhost:5432/social_intel
SCRAPER_URL=http://localhost:4000
# Public URL used by the report worker to request the PDF route
APP_URL=http://localhost:3000
# Protects the internal due-report worker endpoint
REPORT_WORKER_SECRET=change-this-secret
# Used to encrypt organization-owned integration keys at rest. Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=change-this-to-a-long-random-secret
# Sender address used for Resend delivery; each organization supplies its own Resend API key in Settings.
REPORT_FROM_EMAIL=reports@your-verified-domain.com
