DATABASE_URL=postgres://localhost:5432/social_intel
PORT=4000
# Milliseconds to wait between page navigations, keep polite
REQUEST_DELAY_MS=2500
# Optional fallback for direct scraper usage. Dashboard scans use the key saved in Settings.
SERPAPI_KEY=
SERPAPI_MONTHLY_LIMIT=250
# Local guard override only; SerpAPI may still reject requests at the provider limit.
SERPAPI_IGNORE_MONTHLY_LIMIT=false
# Optional exact Google Maps listing data_id; when set, review scans use this listing directly.
SERPAPI_GOOGLE_MAPS_DATA_ID=
# Maximum number of matching Google Maps places to inspect per review scan
SERPAPI_MAX_REVIEW_PLACES=20
